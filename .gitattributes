# Auto-detect text and normalize line endings on commit.
* text=auto eol=lf

# Force LF for files that MUST run on Linux/macOS shells. Without this, a
# Windows checkout produces CRLF endings and the kernel rejects the shebang
# with: env: 'bash\r': No such file or directory.
*.sh         text eol=lf
*.bash       text eol=lf
Makefile     text eol=lf
makefile     text eol=lf
Dockerfile   text eol=lf
.env*        text eol=lf

# Windows-only shells stay CRLF.
*.ps1        text eol=crlf
*.psm1       text eol=crlf
*.psd1       text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Binary assets — never normalize.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.gz         binary
*.tar        binary
*.7z         binary
*.joblib     binary
*.pkl        binary
*.parquet    binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary
